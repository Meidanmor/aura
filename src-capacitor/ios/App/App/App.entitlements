<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Not referenced by the Xcode project yet: real
	     devices need a paid Apple Developer account for this entitlement
	     (Signing & Capabilities → Push Notifications then points here). The
	     CI simulator build signs with it locally, which needs no account. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
