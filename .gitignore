# dependencies
node_modules/

# build output
dist/
.quasar/
.ssh/
# environment files
.env
certs/*
!certs/*.example
# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local cache
.cache/
# Capacitor (native app) — the project is tracked; generated/private files aren't.
# More rules live in src-capacitor/android/.gitignore and src-capacitor/ios/.gitignore.
src-capacitor/node_modules/
src-capacitor/www/
src-capacitor/.native-assets/
# Firebase config is per app/project — keep it private.
src-capacitor/android/app/google-services*.json
src-capacitor/ios/App/App/GoogleService-Info.plist
# Signing keys must never be committed.
*.keystore
*.jks
*.p12
*.mobileprovision
